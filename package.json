{
  "name": "signorebot",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "description": "Локальный Twitch-бот с оверлеями для OBS: команды, награды за баллы, события, шатауты, банворды и медиа-алерты",
  "license": "MIT",
  "author": "Nathaniel Larsson",
  "homepage": "https://aumphaadr.github.io/SignoreBot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aumphaadr/SignoreBot.git"
  },
  "bugs": {
    "url": "https://github.com/Aumphaadr/SignoreBot/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "icons": "node tools/build-icons.mjs",
    "fonts": "node tools/build-fonts.mjs",
    "site": "node tools/build-site.mjs",
    "site:serve": "node tools/serve-site.mjs",
    "test:rust": "cd src-tauri && cargo test",
    "build:linux": "tauri build && bash tools/fix-appimage.sh",
    "release:collect": "bash tools/collect-release.sh",
    "build:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle",
    "icons:sync": "node tools/sync-icons.mjs",
    "licenses": "node tools/licenses.mjs",
    "check": "node tools/check.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "svgo": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
