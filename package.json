{
  "name": "signorebot",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "icons": "node tools/build-icons.mjs",
    "fonts": "node tools/build-fonts.mjs",
    "test:rust": "cd src-tauri && cargo test",
    "build:linux": "tauri build && bash tools/fix-appimage.sh",
    "release:collect": "bash tools/collect-release.sh",
    "build:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "svgo": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
