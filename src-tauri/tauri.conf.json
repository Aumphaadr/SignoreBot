{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SignoreBot",
  "version": "1.0.1",
  "identifier": "ru.aumphaadr.signorebot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SignoreBot",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Локальный Twitch-бот с оверлеями для OBS",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}